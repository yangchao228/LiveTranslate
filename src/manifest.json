{
  "manifest_version": 3,
  "name": "LiveTranslate",
  "version": "1.0.8",
  "minimum_chrome_version": "138",
  "description": "网页输入中译英与正文划词英译中，提供页面连接检查、按需恢复和双向语言包状态。",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LiveTranslate - 翻译与开关",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "translate_selection": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "手动翻译选区或整个草稿"
    },
    "toggle_extension": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "切换输入中译英开关"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "version_name": "1.0.8"
}
